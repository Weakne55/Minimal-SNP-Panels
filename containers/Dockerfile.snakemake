# OCI image for execution by Apptainer/Singularity. Build using Docker/Podman or CI,
# then `apptainer pull ... docker://<registry>/<image>:<tag>` without fakeroot.
FROM mambaorg/micromamba:2.9.0
COPY --chown=$MAMBA_USER:$MAMBA_USER envs/wgs-gatk-mem3.yaml /tmp/environment.yaml
RUN micromamba create --yes --file /tmp/environment.yaml && \
    micromamba clean --all --yes
# apptainer exec does not run the Docker ENTRYPOINT: binaries must be on PATH.
ENV PATH=/opt/conda/envs/wgs-gatk-mem3/bin:$PATH
ENV MAMBA_ROOT_PREFIX=/opt/conda
WORKDIR /work
